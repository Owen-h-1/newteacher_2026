PORT=3000
JWT_SECRET=zhi-keyunshi-dev-secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=zhi_keyunshi

# LLM provider fixed to local Ollama
LLM_PROVIDER=ollama

# Open-source model via local Ollama
OLLAMA_API_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Optional: use Doubao by setting LLM_PROVIDER=doubao
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-1-5-pro-32k-250115
DOUBAO_API_KEY=

# Optional: student study plan agent (Dify app key starts with app-)
VITE_DIFY_BASE_URL=https://api.dify.ai
VITE_STUDENT_STUDY_PLAN_APP_KEY=
# Optional: auto/chat/completion/workflow
VITE_STUDENT_STUDY_PLAN_ROUTE=auto
